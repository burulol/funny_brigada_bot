#!/bin/bash

# Stop and remove old container if it exists
if [ "$(docker ps -aq -f name=funny-bot)" ]; then
    echo "Stopping existing container..."
    docker stop funny-bot
    docker rm funny-bot
fi

# Rebuild Docker image
echo "Building Docker image..."
docker build -t funny-bot .

# Run container in detached mode
echo "Starting bot..."
docker run -d --name funny-bot funny-bot

echo "Bot started in Docker container 'funny-bot'"

